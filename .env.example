# ============================================================================
# MEMPLOYMENT — ENVIRONMENT VARIABLES (.env.example)
# ============================================================================

# Supabase Configuration (Single Source of Truth)
# Provide your Supabase project URL and keys to connect directly to Supabase
# PostgreSQL, Supabase Auth, and Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite Client Mirror (Optional if using NEXT_PUBLIC_ prefix, supported by vite.config.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-Side Admin Provisioning Secret
# Used only by server-side admin bootstrap or CLI scripts. Never expose to clients.
ADMIN_BOOTSTRAP_SECRET=

# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
